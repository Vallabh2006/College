{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run Assembly",
            "type": "shell",
            "command": "nasm -f elf64 \"${file}\" -o \"../Output/${fileBasenameNoExtension}.o\" && nasm -f elf64 \"../Library/compile1.asm\" -o \"../Output/compile1.o\" && ld \"../Output/${fileBasenameNoExtension}.o\" \"../Output/compile1.o\" -o \"../Output/${fileBasenameNoExtension}\" && \"../Output/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Run C++",
            "type": "shell",
            "command": "mkdir -p ../Output && g++ '${fileBasename}' -o '../Output/${fileBasenameNoExtension}' && echo && '../Output/${fileBasenameNoExtension}' && echo",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Python",
            "type": "shell",
            "command": "python3 \"${fileBasename}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}